# Email delivery. Every submission is emailed to CONTACT_TO the moment
# RESEND_API_KEY is set on Vercel. Get the key at resend.com/api-keys.
RESEND_API_KEY=
# Defaults to the address in src/lib/site.ts, which is Deborah's.
CONTACT_TO=
# Resend only accepts a From on a domain verified in the account. Leave
# this empty to send from onboarding@resend.dev, which a new account can
# do with no DNS at all. After verifying deborahroserealestate.com, set
# it to something like "Deborah Rose Real Estate Group <notes@deborahroserealestate.com>".
CONTACT_FROM=

# Optional second channel, delivered alongside the email: any endpoint
# that accepts JSON. A CRM inbound webhook, a Zapier catch hook, a Make
# scenario. This is where an SMS alert would hang.
CONTACT_WEBHOOK_URL=
