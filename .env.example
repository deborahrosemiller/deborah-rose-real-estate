# Where the contact form posts. A Google Apps Script web app running in
# Deborah's own Google account, which mails the note to her with
# GmailApp. The URL ends in /exec. See docs/contact-form.md.
CONTACT_WEBHOOK_URL=
# A long random string, the same one pasted into the Apps Script. A
# deployed web app answers anyone who finds its URL; this is what makes a
# stray post inert. Never commit the real value.
CONTACT_WEBHOOK_SECRET=
